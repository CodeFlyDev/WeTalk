# ============================================================
# WeTalk 环境配置模板
# 复制为 .env 后按需修改：cp .env.example .env（.env 已被 gitignore）
# 生产环境务必修改全部默认密码/密钥！
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_wetalk

# ---- MongoDB ----
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo

# ---- Redis ----
REDIS_PASSWORD=change_me_redis

# ---- MinIO ----
MINIO_ROOT_USER=wetalk-minio
MINIO_ROOT_PASSWORD=change_me_minio_min8chars

# ---- 后端 ----
JWT_SECRET=change_me_jwt_secret_at_least_32_bytes_long

# ---- Keycloak ----
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_kc

# ---- coturn（WebRTC TURN 中继）----
# 部署到云服务器时必须填写公网 IP（本机开发可填 127.0.0.1）
TURN_PUBLIC_IP=
TURN_SECRET=change_me_turn_secret
