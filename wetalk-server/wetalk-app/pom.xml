<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wetalk</groupId>
        <artifactId>wetalk-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wetalk-app</artifactId>
    <name>wetalk-app</name>
    <description>启动模块（聚合全部业务模块，模块化单体入口）</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-friend</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-group</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-message</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-voip</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-social</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-wallet</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
