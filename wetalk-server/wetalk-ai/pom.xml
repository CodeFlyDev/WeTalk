<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wetalk</groupId>
        <artifactId>wetalk-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wetalk-ai</artifactId>
    <name>wetalk-ai</name>
    <description>AI 域服务（Whisper 转写 / Ollama 助手与摘要 / RAG 知识库；Phase 8 拆为独立进程）</description>

    <dependencies>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-common</artifactId>
        </dependency>
        <!-- 复用 JWT 安全基座（SecurityConfig/JwtTokenService/CurrentUser），不再依赖 message/file 模块：
             跨服务数据访问经 CoreClient HTTP 调 core（参与者校验在 core 侧闭环） -->
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- RAG 知识库：ES dense_vector（独立 index，数据天然属于 AI 域） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>
        <!-- 语音文件直读 MinIO（基础设施访问，不经 core 中转） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
    </dependencies>
</project>
