<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wetalk</groupId>
        <artifactId>wetalk-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wetalk-wallet</artifactId>
    <name>wetalk-wallet</name>
    <description>钱包（余额/流水）+ 红包（RocketMQ 事务消息：半消息 → 本地事务 → 回查）</description>

    <dependencies>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-common</artifactId>
        </dependency>
        <!-- 复用 MessageService（红包消息落会话）与 FriendPort/GroupPort 参与者校验 -->
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-message</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 红包详情解析领取人昵称 -->
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-user</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- RocketMQ 事务消息（发红包：扣款本地事务 + 消息投递最终一致） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>
</project>
