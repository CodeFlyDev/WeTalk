<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.wetalk</groupId>
    <artifactId>wetalk-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>wetalk-server</name>
    <description>WeTalk IM 平台后端（模块化单体 → 微服务演进）</description>

    <modules>
        <module>wetalk-common</module>
        <module>wetalk-auth</module>
        <module>wetalk-user</module>
        <module>wetalk-friend</module>
        <module>wetalk-group</module>
        <module>wetalk-message</module>
        <module>wetalk-file</module>
        <module>wetalk-voip</module>
        <module>wetalk-social</module>
        <module>wetalk-wallet</module>
        <module>wetalk-ai</module>
        <module>wetalk-gateway</module>
        <module>wetalk-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块统一版本管理 -->
            <dependency>
                <groupId>com.wetalk</groupId>
                <artifactId>wetalk-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 后续按需在此登记 gRPC / Spring Cloud / Spring AI BOM（Phase 2-8） -->
        </dependencies>
    </dependencyManagement>
</project>
