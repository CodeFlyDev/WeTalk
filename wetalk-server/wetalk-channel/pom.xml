<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wetalk</groupId>
        <artifactId>wetalk-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wetalk-channel</artifactId>
    <name>wetalk-channel</name>
    <description>频道/社区（公开频道 + 文字消息流）</description>

    <dependencies>
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-common</artifactId>
        </dependency>
        <!-- CurrentUser -->
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 成员昵称解析 -->
        <dependency>
            <groupId>com.wetalk</groupId>
            <artifactId>wetalk-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- 频道消息（独立 Mongo 集合，不进主消息链路） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!-- /topic/channel.{id} 实时广播 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
    </dependencies>
</project>
